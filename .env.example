# ============================================
# NeuroLearn AI — Environment Configuration
# ============================================
# Copy this file to .env and fill in your keys:
# --> cp .env.example .env
# ============================================

# --- AI API Keys ---
GROQ_API_KEY="your-groq-api-key"
OPENROUTER_API_KEY="your-openrouter-api-key"           # Optional — for model diversity
SECRET_KEY="change-this-to-a-random-secret"

# Groq Model Configuration — Verified LIVE Sep 16, 2026
# Models confirmed active via API: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b
# NOTE: llama-3.3-70b, llama-4-scout, llama-3.1-8b-instant are all DEPRECATED on this account
SYLLABUS_MODEL="openai/gpt-oss-120b"
CHAPTER_MODEL="openai/gpt-oss-20b"
TUTOR_MODEL="openai/gpt-oss-20b"
FALLBACK_MODEL="openai/gpt-oss-20b"
# SYLLABUS uses 120b because syllabus JSON (10 chapters + content_slices) is too long for 20b

# Hugging Face API Key (for manga image generation in Story Mode)
HUGGINGFACE_API_KEY="your_key"

# --- Firebase ---
FIREBASE_API_KEY="your-firebase-api-key"
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
FIREBASE_APP_ID="your-app-id"
FIREBASE_MEASUREMENT_ID="your-measurement-id"